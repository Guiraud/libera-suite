From e374c0a0e1344362508f8644ccf606933dddcc76 Mon Sep 17 00:00:00 2001
From: Stefane Fermigier <sf@abilian.com>
Date: Fri, 25 Sep 2026 18:32:42 +0200
Subject: [PATCH 68/82] OdfFile writer: one line numbering configuration for
 the document

Each DOCX section can have its own w:lnNumType, and each became a
text:linenumbering-configuration in office:styles, which allows one:
4 of LibreOffice's ODF test documents after the eighth batch. The
first is kept.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 OdfFile/Writer/Format/styles.cpp | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/OdfFile/Writer/Format/styles.cpp b/OdfFile/Writer/Format/styles.cpp
index cfef448cfb..7e114f916a 100644
--- a/OdfFile/Writer/Format/styles.cpp
+++ b/OdfFile/Writer/Format/styles.cpp
@@ -912,7 +912,9 @@ void office_styles::add_child_element( const office_element_ptr & child)
 		text_notes_configuration_.push_back(child);
 		break;
 	case typeTextLinenumberingConfiguration:
-		text_linenumbering_configuration_.push_back(child);
+		// ODF has one for the document, where each DOCX section can have its own: the first is kept
+		if (text_linenumbering_configuration_.empty())
+			text_linenumbering_configuration_.push_back(child);
 		break;
 	//....
 	}
