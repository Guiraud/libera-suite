From a839577b9cc9dbca98ac1a29689c7d556f4abb29 Mon Sep 17 00:00:00 2001
From: Stefane Fermigier <sf@abilian.com>
Date: Fri, 25 Sep 2026 08:59:17 +0200
Subject: [PATCH 141/142] OdfFile writer: a named range without a sheet keeps
 the dot

A sheet-scoped name, as x2t's reader writes it, gives its range without
the sheet: $B$2. ODF allows the sheet to be left out only with the
dot, .$B$2, relative to the base cell's table, so every such name was
invalid: 9 of LibreOffice's ODF test documents after the sixth batch,
mostly Solver models. Each end of such a range now starts with the dot,
and the name gets its sheet's first cell as base cell when the sheet is
known.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 OdfFile/Writer/Format/ods_table_context.cpp | 21 +++++++++++++++++++++
 1 file changed, 21 insertions(+)

diff --git a/OdfFile/Writer/Format/ods_table_context.cpp b/OdfFile/Writer/Format/ods_table_context.cpp
index 60d7684a47..7f39042183 100644
--- a/OdfFile/Writer/Format/ods_table_context.cpp
+++ b/OdfFile/Writer/Format/ods_table_context.cpp
@@ -487,6 +487,27 @@ void ods_table_context::add_defined_range(const std::wstring & name, const std::
 	
 	std::wstring odf_base_cell = formulas_converter.get_table_name();
 
+	// A sheet's own name may leave its sheet out, "$B$2", as x2t's reader writes it. ODF allows
+	// that only as ".$B$2", relative to the table of the base cell
+	if (false == odf_range.empty() && std::wstring::npos == odf_range.find(L'.'))
+	{
+		std::wstring relative;
+		for (size_t start = 0, colon; ; start = colon + 1)
+		{
+			colon = odf_range.find(L':', start);
+			relative += (start ? L":." : L".") + odf_range.substr(start, std::wstring::npos == colon ? std::wstring::npos : colon - start);
+			if (std::wstring::npos == colon) break;
+		}
+		odf_range = relative;
+
+		if (odf_base_cell.empty() && sheet_id >= 0 && sheet_id < (int)table_state_list_.size())
+		{
+			std::wstring sheet = table_state_list_[sheet_id]->office_table_name_;
+			XmlUtils::replace_all(sheet, L"'", L"''");
+			odf_base_cell = L"$'" + sheet + L"'.$A$1";
+		}
+	}
+
 	named_range->table_name_ = name;
 	named_range->table_cell_range_address_ = odf_range;
 	
