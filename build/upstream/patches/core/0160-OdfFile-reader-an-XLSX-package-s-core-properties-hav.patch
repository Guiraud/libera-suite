From fcaa24a0d5fa28cef03b06d8b0fc296c668fec03 Mon Sep 17 00:00:00 2001
From: Stefane Fermigier <sf@abilian.com>
Date: Fri, 25 Sep 2026 21:54:39 +0200
Subject: [PATCH 74/82] OdfFile reader: an XLSX package's core properties have
 the right relationship

The package relationship to docProps/core.xml was typed
http://schemas.openxmlformats.org/officedocument/2006/relationships/metadata/core-properties,
a URI no specification has, where the DOCX and PPTX packages use the
right one, .../package/2006/relationships/metadata/core-properties. A
consumer does not find the document's properties, and officeotron
reports every XLSX x2t writes: all 1 348 of the XLSX middle legs of
LibreOffice's ODF test documents.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 OdfFile/Reader/Converter/xlsx_package.cpp | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/OdfFile/Reader/Converter/xlsx_package.cpp b/OdfFile/Reader/Converter/xlsx_package.cpp
index eab97bd4fb..98d371b9e5 100644
--- a/OdfFile/Reader/Converter/xlsx_package.cpp
+++ b/OdfFile/Reader/Converter/xlsx_package.cpp
@@ -63,7 +63,7 @@ xlsx_document::xlsx_document()
     rels_file_ptr relFile = rels_file::create(L".rels");
    
 	relFile->get_rels().add(relationship(L"rId1", L"http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument", L"xl/workbook.xml"));
-    relFile->get_rels().add(relationship(L"rId2", L"http://schemas.openxmlformats.org/officedocument/2006/relationships/metadata/core-properties", L"docProps/core.xml"));
+    relFile->get_rels().add(relationship(L"rId2", L"http://schemas.openxmlformats.org/package/2006/relationships/metadata/core-properties", L"docProps/core.xml"));
     relFile->get_rels().add(relationship(L"rId3", L"http://schemas.openxmlformats.org/officeDocument/2006/relationships/extended-properties", L"docProps/app.xml"));
    
 	get_rels_files().add_rel_file( relFile );
