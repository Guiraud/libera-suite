From 92732e4e4f9c425df9e43e9e26f507e9dc3c4fc2 Mon Sep 17 00:00:00 2001
From: Stefane Fermigier <sf@abilian.com>
Date: Tue, 22 Sep 2026 21:25:25 +0200
Subject: [PATCH 24/82] OdfFile writer: spreadsheet header text outside any
 region goes centre

XlsxConverter only opened a style:region-left/-center/-right when the
header text carried &L, &C or &R. Text before any of them, which is
what "Page &P" or a bare "&A" is, went straight into style:header
or style:footer as text:span elements, and the schema allows neither
spans nor bare text there. Excel shows unsectioned header text in the
centre section, so it now opens style:region-center.

Found in 1219 of LibreOffice's 3794 ODF test documents after a round
trip: the ODF reader writes LibreOffice's default headers without a
section code, so every spreadsheet with one came back invalid.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 OdfFile/Writer/Converter/XlsxConverter.cpp | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/OdfFile/Writer/Converter/XlsxConverter.cpp b/OdfFile/Writer/Converter/XlsxConverter.cpp
index 2e5c34390f..98ad37ff0b 100644
--- a/OdfFile/Writer/Converter/XlsxConverter.cpp
+++ b/OdfFile/Writer/Converter/XlsxConverter.cpp
@@ -714,6 +714,9 @@ void XlsxConverter::convert(OOX::Spreadsheet::CHeaderFooterElement	*oox_header_f
 	odf_writer::style_text_properties current_text_props;
 	
 	int type_add = 0;
+	// Text before any &L, &C or &R belongs to no region, and a style:header
+	// cannot hold a span directly. Excel shows such text centred, so it goes there.
+	bool in_region = false;
 	while(pos < oox_header_footer->m_sText.size())
 	{
 		if (oox_header_footer->m_sText[pos] == L'&')
@@ -727,16 +730,19 @@ void XlsxConverter::convert(OOX::Spreadsheet::CHeaderFooterElement	*oox_header_f
 					{
 						current_text_props.content_.clear();
 						ods_context->start_header_footer_region(1); pos++;
+						in_region = true;
 					}break;
 				case 'C':	
 					{
 						current_text_props.content_.clear();
 						ods_context->start_header_footer_region(2); pos++; 
+						in_region = true;
 					}break;
 				case 'R':	
 					{
 						current_text_props.content_.clear();						
 						ods_context->start_header_footer_region(3); pos++; 
+						in_region = true;
 					}break;
 
 				case 'A':	type_add = 1; pos++; break;
@@ -866,6 +872,11 @@ void XlsxConverter::convert(OOX::Spreadsheet::CHeaderFooterElement	*oox_header_f
 
 		if (type_add > 0 || next - pos > 0)
 		{
+			if (!in_region)
+			{
+				ods_context->start_header_footer_region(2);
+				in_region = true;
+			}
 			ods_context->text_context()->get_styles_context()->create_style(L"", odf_types::style_family::Text, true, false, -1);					
 			odf_writer::text_format_properties *text_properties = ods_context->text_context()->get_styles_context()->last_state()->get_text_properties();
 			text_properties->apply_from(current_text_props.content_);
