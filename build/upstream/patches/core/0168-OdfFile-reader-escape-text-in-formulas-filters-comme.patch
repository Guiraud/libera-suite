@@ -1382,7 +1382,7 @@ void table_covered_table_cell::xlsx_convert(oox::xlsx_conversion_context & Conte
                         {
                             CP_XML_NODE(L"f")
                             {
-                                CP_XML_CONTENT(xlsxFormula);
+                                CP_XML_CONTENT(XmlUtils::EncodeXmlString(xlsxFormula)); // as for any other cell
                             }
                         }
                     }
