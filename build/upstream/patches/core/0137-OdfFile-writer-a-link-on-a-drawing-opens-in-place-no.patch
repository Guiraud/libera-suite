From ee960576df88605910e1382183e8fcaf7dbcc8f9 Mon Sep 17 00:00:00 2001
From: Stefane Fermigier <sf@abilian.com>
Date: Fri, 25 Sep 2026 08:55:09 +0200
Subject: [PATCH 137/142] OdfFile writer: a link on a drawing opens in place,
 not embedded

start_link_object wrote the draw:a around a linked image or shape with
xlink:show="embed", the value for an embedded image. A link takes new or
replace, so every image with a hyperlink was invalid: 14 of
LibreOffice's ODF test documents after the sixth batch. It is now
replace, a link's default.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 OdfFile/Writer/Format/odf_drawing_context.cpp | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/OdfFile/Writer/Format/odf_drawing_context.cpp b/OdfFile/Writer/Format/odf_drawing_context.cpp
index 9735966dd6..63280cb3e8 100644
--- a/OdfFile/Writer/Format/odf_drawing_context.cpp
+++ b/OdfFile/Writer/Format/odf_drawing_context.cpp
@@ -3170,7 +3170,7 @@ void odf_drawing_context::start_link_object(std::wstring href)
 	{
 		draw_a_->xlink_attlist_.href_		= href;
 		draw_a_->xlink_attlist_.type_		= xlink_type::Simple;
-		draw_a_->xlink_attlist_.show_		= xlink_show::Embed;
+		draw_a_->xlink_attlist_.show_		= xlink_show::Replace; // a link takes new or replace, not embed
 		draw_a_->xlink_attlist_.actuate_	= xlink_actuate::OnRequest;
 	}
 }
