From 4fc889fe1433475bf80823416009a6c3eaf6fabd Mon Sep 17 00:00:00 2001
From: Stefane Fermigier <sf@abilian.com>
Date: Fri, 25 Sep 2026 18:32:42 +0200
Subject: [PATCH 69/82] OdfFile writer: an image the source does not hold is
 not listed

An image or an object's preview that the source names but does not
contain, as x2t's reader sometimes writes an OLE object's, was still
registered: the manifest listed it and the package did not have it,
4 of LibreOffice's ODF test documents after the eighth batch. add_image
and add_imageobject now leave out a file that does not exist, and
set_bitmap_link goes through add_image.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 OdfFile/Writer/Format/odf_conversion_context.cpp | 5 +++++
 OdfFile/Writer/Format/odf_drawing_context.cpp    | 4 +++-
 2 files changed, 8 insertions(+), 1 deletion(-)

diff --git a/OdfFile/Writer/Format/odf_conversion_context.cpp b/OdfFile/Writer/Format/odf_conversion_context.cpp
index 9943dde5bd..9b17d52086 100644
--- a/OdfFile/Writer/Format/odf_conversion_context.cpp
+++ b/OdfFile/Writer/Format/odf_conversion_context.cpp
@@ -41,6 +41,7 @@
 #include "../../DesktopEditor/graphics/pro/Fonts.h"
 
 #include "../../Common/utils.h"
+#include "../../../DesktopEditor/common/File.h"
 
 namespace cpdoccore { 
 
@@ -552,6 +553,8 @@ void odf_conversion_context::add_meta(const std::wstring & ns, const std::wstrin
 std::wstring odf_conversion_context::add_image(const std::wstring & image_file_name, bool bExternal)
 {
 	if (image_file_name.empty()) return L"";
+	// An image the source names but does not hold would be listed in the manifest and missing
+	if (!bExternal && !NSFile::CFileBinary::Exists(image_file_name)) return L"";
 	
 	if (bExternal)
 	{
@@ -584,6 +587,8 @@ std::wstring odf_conversion_context::add_media(const std::wstring & file_name, b
 std::wstring odf_conversion_context::add_imageobject(const std::wstring & file_name, bool bExternal)
 {
 	if (file_name.empty()) return L"";
+	// A preview the source names but does not hold would be listed in the manifest and missing
+	if (!bExternal && !NSFile::CFileBinary::Exists(file_name)) return L"";
 	
 	if (bExternal)
 	{
diff --git a/OdfFile/Writer/Format/odf_drawing_context.cpp b/OdfFile/Writer/Format/odf_drawing_context.cpp
index 33eaa3f641..a7539ae218 100644
--- a/OdfFile/Writer/Format/odf_drawing_context.cpp
+++ b/OdfFile/Writer/Format/odf_drawing_context.cpp
@@ -4185,7 +4185,9 @@ void odf_drawing_context::set_bitmap_link(std::wstring path, bool bExternal)
 	}
 	else
 	{
-		impl_->odf_context_->mediaitems()->add_or_find(path, _mediaitems::typeImage, odf_ref_name);
+		// through add_image, which leaves out an image the source names but does not hold
+		odf_ref_name = impl_->odf_context_->add_image(path, false);
+		if (odf_ref_name.empty()) return;
 	}
 	
 	if (impl_->current_drawing_state_.oox_shape_preset_ == 3000)
-- 
