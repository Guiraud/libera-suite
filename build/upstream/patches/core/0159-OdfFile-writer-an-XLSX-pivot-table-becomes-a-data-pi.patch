 void ods_table_context::start_pivot_table(const std::wstring &name)
 {
-	if (!table_pivots_.root) create_element(L"table", L"data-pilot-tables", table_pivots_.root, &context_);
-
 	office_element_ptr elm;
 	create_element(L"table", L"data-pilot-table", elm, &context_);
 	table_data_pilot_table *pilot_table = dynamic_cast<table_data_pilot_table*>(elm.get());
@@ -219,13 +217,61 @@ void ods_table_context::start_pivot_table(const std::wstring &name)
 	if (!pilot_table) return;
 
 	pilot_table->table_name_ = name;
-
-	table_pivots_.root->add_child_element(elm);
+	current_pivot_ = elm;
 
 	state()->start_pilot_table(elm);
 }
+void ods_table_context::set_pivot_table_ranges(const std::wstring &target, const std::wstring &source)
+{
+	table_data_pilot_table *pilot_table = dynamic_cast<table_data_pilot_table*>(current_pivot_.get());
+	if (!pilot_table) return;
+
+	if (!target.empty()) pilot_table->table_target_range_address_ = target;
+	if (!source.empty())
+	{
+		office_element_ptr elm;
+		create_element(L"table", L"source-cell-range", elm, &context_);
+		table_source_cell_range *range = dynamic_cast<table_source_cell_range*>(elm.get());
+		if (!range) return;
+
+		range->table_cell_range_address_ = source;
+		pilot_table->add_child_element(elm);
+	}
+}
+void ods_table_context::add_pivot_table_field(const std::wstring &name, table_orientation::type orientation, int function, bool data_layout)
+{
+	table_data_pilot_table *pilot_table = dynamic_cast<table_data_pilot_table*>(current_pivot_.get());
+	if (!pilot_table) return;
+
+	office_element_ptr elm;
+	create_element(L"table", L"data-pilot-field", elm, &context_);
+	table_data_pilot_field *field = dynamic_cast<table_data_pilot_field*>(elm.get());
+	if (!field) return;
+
+	field->table_source_field_name_ = name;
+	field->table_orientation_ = table_orientation(orientation);
+	if (function >= 0)
+		field->table_function_ = table_function((table_function::type)function);
+	if (data_layout)
+		field->table_is_data_layout_field_ = Bool(true);
+	if (orientation == table_orientation::page)
+	{
+		// A page field needs a selected page; LibreOffice's flag shows every page instead
+		field->table_selected_page_ = L"";
+		field->loext_ignore_selected_page_ = Bool(true);
+	}
+	pilot_table->add_child_element(elm);
+}
 void ods_table_context::end_pivot_table()
 {
+	// Written only with what the schema requires of it: where it goes, and a field
+	table_data_pilot_table *pilot_table = dynamic_cast<table_data_pilot_table*>(current_pivot_.get());
+	if (pilot_table && pilot_table->table_target_range_address_ && !pilot_table->fields_.empty())
+	{
+		if (!table_pivots_.root) create_element(L"table", L"data-pilot-tables", table_pivots_.root, &context_);
+		table_pivots_.root->add_child_element(current_pivot_);
+	}
+	current_pivot_.reset();
 	state()->end_pilot_table();
 }
 bool ods_table_context::start_data_validation( const std::wstring &strRef, int type)
