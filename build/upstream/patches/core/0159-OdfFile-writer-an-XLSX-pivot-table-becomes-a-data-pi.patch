+// A sheet and an XLSX range, A1:C20, as an ODF cell range address, with the sheet quoted.
+static std::wstring odf_pivot_range(std::wstring sheet, const std::wstring & ref)
+{
+	XmlUtils::replace_all(sheet, L"'", L"''");
+	const std::wstring prefix = L"'" + sheet + L"'.";
+	const size_t colon = ref.find(L':');
+	if (colon == std::wstring::npos) return prefix + ref;
+	return prefix + ref.substr(0, colon) + L":" + prefix + ref.substr(colon + 1);
+}
 void XlsxConverter::convert(OOX::Spreadsheet::CPivotTableDefinition *oox_pivot_table, OOX::Spreadsheet::CPivotCacheDefinition* oox_pivot_cache)
 {
 	if (!oox_pivot_table || !oox_pivot_cache) return;
 
 	ods_context->start_pivot_table(oox_pivot_table->m_oName.IsInit() ? *oox_pivot_table->m_oName : L"");
 
-	convert(oox_pivot_table->m_oLocation.GetPointer());
-	if (oox_pivot_table->m_oPivotFields.IsInit())
+	// Where it goes, what it reads, and its fields in the order ODF gives them meaning: page,
+	// row, column and data fields, then the source's other fields as hidden. The writer used to
+	// write the name alone, which the schema rejects and LibreOffice cannot use.
+	const std::wstring sheet = ods_context->current_table()->office_table_name_;
+	std::wstring target, source;
+	if (oox_pivot_table->m_oLocation.IsInit() && oox_pivot_table->m_oLocation->m_oRef.IsInit())
+		target = odf_pivot_range(sheet, *oox_pivot_table->m_oLocation->m_oRef);
+	if (oox_pivot_cache->m_oCacheSource.IsInit() && oox_pivot_cache->m_oCacheSource->m_oWorksheetSource.IsInit())
 	{
-		for (size_t i = 0; i < oox_pivot_table->m_oPivotFields->m_arrItems.size(); i++)
+		const OOX::Spreadsheet::CWorksheetSource & worksheet = oox_pivot_cache->m_oCacheSource->m_oWorksheetSource.get();
+		if (worksheet.m_oRef.IsInit())
+			source = odf_pivot_range(worksheet.m_oSheet.IsInit() ? *worksheet.m_oSheet : sheet, *worksheet.m_oRef);
+	}
+	ods_context->set_pivot_table_ranges(target, source);
+
+	std::vector<std::wstring> names;
+	if (oox_pivot_cache->m_oCacheFields.IsInit())
+	{
+		for (size_t i = 0; i < oox_pivot_cache->m_oCacheFields->m_arrItems.size(); i++)
 		{
-			convert(oox_pivot_table->m_oPivotFields->m_arrItems[i]);
+			OOX::Spreadsheet::CPivotCacheField *field = oox_pivot_cache->m_oCacheFields->m_arrItems[i];
+			names.push_back(field && field->m_oName.IsInit() ? *field->m_oName : L"");
 		}
 	}
-	//if (oox_pivot_table->m_oDataFields.IsInit())
-	//{
-	//	for (size_t i = 0; i < oox_pivot_table->m_oDataFields->m_arrItems.size(); i++)
-	//	{
-	//		convert(oox_pivot_table->m_oDataFields->m_arrItems[i]);
-	//	}
-	//}
-	//if (oox_pivot_table->m_oColFields.IsInit())
-	//{
-	//	for (size_t i = 0; i < oox_pivot_table->m_oColFields->m_arrItems.size(); i++)
-	//	{
-	//		convert(oox_pivot_table->m_oColFields->m_arrItems[i]);
-	//	}
-	//}
-	//if (oox_pivot_table->m_oRowFields.IsInit())
-	//{
-	//	for (size_t i = 0; i < oox_pivot_table->m_oRowFields->m_arrItems.size(); i++)
-	//	{
-	//		convert(oox_pivot_table->m_oRowFields->m_arrItems[i]);
-	//	}
-	//}
+	std::vector<bool> used(names.size(), false);
+	typedef odf_types::table_orientation orientation;
+
 	if (oox_pivot_table->m_oPageFields.IsInit())
 	{
 		for (size_t i = 0; i < oox_pivot_table->m_oPageFields->m_arrItems.size(); i++)
 		{
-			convert(oox_pivot_table->m_oPageFields->m_arrItems[i]);
+			OOX::Spreadsheet::CPageField *field = oox_pivot_table->m_oPageFields->m_arrItems[i];
+			if (!field || !field->m_oFld.IsInit() || *field->m_oFld < 0 || *field->m_oFld >= (int)names.size()) continue;
+			ods_context->add_pivot_table_field(names[*field->m_oFld], orientation::page, -1, false);
+			used[*field->m_oFld] = true;
 		}
 	}
+	for (int axis = 0; axis < 2; axis++)
+	{
+		nullable<OOX::Spreadsheet::CColumnRowFields> & fields = axis == 0 ? oox_pivot_table->m_oRowFields : oox_pivot_table->m_oColFields;
+		if (!fields.IsInit()) continue;
+		for (size_t i = 0; i < fields->m_arrItems.size(); i++)
+		{
+			OOX::Spreadsheet::CField *field = fields->m_arrItems[i];
+			if (!field || !field->m_oX.IsInit()) continue;
+			const orientation::type where = axis == 0 ? orientation::row : orientation::column;
+			if (*field->m_oX == -2) // the values of several data fields, side by side
+				ods_context->add_pivot_table_field(L"", where, odf_types::table_function::Auto, true);
+			else if (*field->m_oX >= 0 && *field->m_oX < (int)names.size())
+			{
+				ods_context->add_pivot_table_field(names[*field->m_oX], where, -1, false);
+				used[*field->m_oX] = true;
+			}
+		}
+	}
+	if (oox_pivot_table->m_oDataFields.IsInit())
+	{
+		for (size_t i = 0; i < oox_pivot_table->m_oDataFields->m_arrItems.size(); i++)
+		{
+			OOX::Spreadsheet::CDataField *field = oox_pivot_table->m_oDataFields->m_arrItems[i];
+			if (!field || !field->m_oFld.IsInit() || field->m_oFld->GetValue() >= names.size()) continue;
+
+			int function = odf_types::table_function::sum;
+			if (field->m_oSubtotal.IsInit())
+			{
+				switch (field->m_oSubtotal->GetValue())
+				{
+				case SimpleTypes::Spreadsheet::functionAverage:		function = odf_types::table_function::average;		break;
+				case SimpleTypes::Spreadsheet::functionCount:		function = odf_types::table_function::count;		break;
+				case SimpleTypes::Spreadsheet::functionCountNums:	function = odf_types::table_function::countnums;	break;
+				case SimpleTypes::Spreadsheet::functionMaximum:		function = odf_types::table_function::max;			break;
+				case SimpleTypes::Spreadsheet::functionMinimum:		function = odf_types::table_function::min;			break;
+				case SimpleTypes::Spreadsheet::functionProduct:		function = odf_types::table_function::product;		break;
+				case SimpleTypes::Spreadsheet::functionStdDev:		function = odf_types::table_function::stdev;		break;
+				case SimpleTypes::Spreadsheet::functionStdDevP:		function = odf_types::table_function::stdevp;		break;
+				case SimpleTypes::Spreadsheet::functionVariance:	function = odf_types::table_function::var;			break;
+				case SimpleTypes::Spreadsheet::functionVarP:		function = odf_types::table_function::varp;			break;
+				default:																								break;
+				}
+			}
+			ods_context->add_pivot_table_field(names[field->m_oFld->GetValue()], orientation::data, function, false);
+			used[field->m_oFld->GetValue()] = true;
+		}
+	}
+	for (size_t i = 0; i < names.size(); i++)
+	{
+		if (!used[i]) ods_context->add_pivot_table_field(names[i], orientation::hidden, -1, false);
+	}
 
 	ods_context->end_pivot_table();
 }
