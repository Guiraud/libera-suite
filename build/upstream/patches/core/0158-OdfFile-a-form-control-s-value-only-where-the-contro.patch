From 55435eb04dcac3263f1dc3c960374fb9904645c9 Mon Sep 17 00:00:00 2001
From: Stefane Fermigier <sf@abilian.com>
Date: Fri, 25 Sep 2026 19:24:01 +0200
Subject: [PATCH 72/82] OdfFile: a form control's value only where the control
 takes one

Every control was written with form:value and form:current-value, which
ODF allows only on some: 38 of LibreOffice's ODF test documents after the
ninth batch. A label (form:fixed-text) takes neither, and its text is its
form:label; a list box takes neither, its selection being in its options
or its linked cell; a check box, radio button, button or value range
takes form:value but not form:current-value. A radio button also carried
form:input-required and form:group-name, which it does not take.

The reader writes a Word label's text from form:current-value; it now
falls back to form:value, then form:label, so the text survives.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 OdfFile/Reader/Format/office_forms.cpp |  6 ++++--
 OdfFile/Writer/Format/office_forms.cpp | 20 +++++++++++++++-----
 2 files changed, 19 insertions(+), 7 deletions(-)

diff --git a/OdfFile/Reader/Format/office_forms.cpp b/OdfFile/Reader/Format/office_forms.cpp
index eb6621ad80..b294bcfdd6 100644
--- a/OdfFile/Reader/Format/office_forms.cpp
+++ b/OdfFile/Reader/Format/office_forms.cpp
@@ -586,11 +586,13 @@ void form_fixed_text::docx_convert_sdt(oox::docx_conversion_context & Context, d
 		Context.output_stream() << L"</w:sdtPr>";
 		Context.output_stream() << L"<w:sdtContent>";
 		{
+			// ODF has a label's text in form:label; x2t used to write it as the value
+			const _CP_OPT(std::wstring) & text = current_value_ ? current_value_ : (value_ ? value_ : label_);
 			Context.add_new_run(L"");
-			if (current_value_)
+			if (text)
 			{
 				Context.output_stream() << L"<w:t xml:space=\"preserve\">";
-				Context.output_stream() << XmlUtils::EncodeXmlString(*current_value_ );
+				Context.output_stream() << XmlUtils::EncodeXmlString(*text );
 				Context.output_stream() << L"</w:t>";
 			}
 			Context.finish_run();
diff --git a/OdfFile/Writer/Format/office_forms.cpp b/OdfFile/Writer/Format/office_forms.cpp
index b93938856e..5785fdaa2e 100644
--- a/OdfFile/Writer/Format/office_forms.cpp
+++ b/OdfFile/Writer/Format/office_forms.cpp
@@ -234,19 +234,31 @@ const wchar_t * form_element::name = L"element";
 
 void form_element::serialize_attlist(CP_ATTR_NODE)
 {
+	// A value only on a control that takes one: form:value on what submits a value,
+	// form:current-value on what the user types into. A label's text is its form:label; a list
+	// box's selection is in its options or its linked cell.
+	const bool is_label		= dynamic_cast<form_fixed_text*>(this) != NULL;
+	const bool no_value		= is_label || dynamic_cast<form_listbox*>(this) || dynamic_cast<form_image_frame*>(this) ||
+							  dynamic_cast<form_frame*>(this);
+	const bool no_current	= no_value || dynamic_cast<form_checkbox*>(this) || dynamic_cast<form_button*>(this) ||
+							  dynamic_cast<form_value_range*>(this); // form_radio is a form_checkbox
+	_CP_OPT(std::wstring) label = label_;
+	if (is_label && !label)
+		label = current_value_ ? current_value_ : value_;
+
 	CP_XML_ATTR_OPT(L"form:name", name_);
 	CP_XML_ATTR_OPT(L"form:control-implementation",	control_implementation_);
 	CP_XML_ATTR_OPT(L"form:data-field", data_field_);
 	CP_XML_ATTR_OPT(L"form:linked-cell", linked_cell_);
 	CP_XML_ATTR_OPT(L"form:disabled", disabled_);
 	CP_XML_ATTR_OPT(L"form:id", id_);
-	CP_XML_ATTR_OPT_ENCODE_STRING(L"form:label", label_);
+	CP_XML_ATTR_OPT_ENCODE_STRING(L"form:label", label);
 	CP_XML_ATTR_OPT(L"form:printable", printable_);
 	CP_XML_ATTR_OPT(L"form:tab-index", tab_index_);
 	CP_XML_ATTR_OPT(L"form:tab-stop", tab_stop_);
 	CP_XML_ATTR_OPT_ENCODE_STRING(L"form:title", title_);
-	CP_XML_ATTR_OPT_ENCODE_STRING(L"form:value", value_);
-	CP_XML_ATTR_OPT_ENCODE_STRING(L"form:current-value", current_value_);
+	if (!no_value)		CP_XML_ATTR_OPT_ENCODE_STRING(L"form:value", value_);
+	if (!no_current)	CP_XML_ATTR_OPT_ENCODE_STRING(L"form:current-value", current_value_);
 	CP_XML_ATTR_OPT(L"form:dropdown", dropdown_);
 	CP_XML_ATTR_OPT(L"xml:id", xml_id_);
 	CP_XML_ATTR_OPT(L"xforms:bind", xforms_bind_);
@@ -388,8 +400,6 @@ void form_radio::serialize(std::wostream & _Wostream)
 			}
 			
 			CP_XML_ATTR(L"form:visual-effect", L"flat");			
-			CP_XML_ATTR(L"form:input-required", L"false");			
-			CP_XML_ATTR(L"form:group-name", L"autoGroup_formControl");			
 
 			if (properties_) properties_->serialize(CP_XML_STREAM());
 			if (office_event_listeners_) office_event_listeners_->serialize(CP_XML_STREAM());
