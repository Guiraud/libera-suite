From cada49976a0d0e9386618c37fa136e2051e806bc Mon Sep 17 00:00:00 2001
From: Stefane Fermigier <sf@abilian.com>
Date: Thu, 24 Sep 2026 19:24:46 +0200
Subject: [PATCH 34/82] OdfFile writer: chart:treat-empty-cells from
 c:dispBlanksAs, not true

The writer set chart:treat-empty-cells to true on every plot area and
ignored the chart's c:dispBlanksAs. The attribute takes ignore, leave-gap
or use-zero, so every 2D chart it wrote was invalid: 205 of LibreOffice's
ODF test documents after the third batch. The attribute is now a string,
set from dispBlanksAs (span, gap, zero) when the chart has one; a chart
without it, and a 3D chart as before, gets no attribute.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 OdfFile/Writer/Converter/ConverterChart.cpp    |  3 +++
 OdfFile/Writer/Format/odf_chart_context.cpp    | 16 ++++++++++++++--
 OdfFile/Writer/Format/odf_chart_context.h      |  1 +
 OdfFile/Writer/Format/style_chart_properties.h |  2 +-
 4 files changed, 19 insertions(+), 3 deletions(-)

diff --git a/OdfFile/Writer/Converter/ConverterChart.cpp b/OdfFile/Writer/Converter/ConverterChart.cpp
index 7947242d42..9eed7ce722 100644
--- a/OdfFile/Writer/Converter/ConverterChart.cpp
+++ b/OdfFile/Writer/Converter/ConverterChart.cpp
@@ -117,6 +117,9 @@ void OoxConverter::convert(OOX::Spreadsheet::CT_ChartSpace  *oox_chart)
 
 	odf_context()->chart_context()->start_plot_area();
 	{
+		if (oox_chart->m_chart->m_dispBlanksAs.IsInit())
+			odf_context()->chart_context()->set_chart_treat_empty_cells(oox_chart->m_chart->m_dispBlanksAs->GetValue());
+
 		convert(oox_chart->m_chart->m_plotArea); 
 			
 		bool chart3D = (oox_chart->m_chart->m_view3D) ? true : false;
diff --git a/OdfFile/Writer/Format/odf_chart_context.cpp b/OdfFile/Writer/Format/odf_chart_context.cpp
index 0bef02986c..2c08325b89 100644
--- a/OdfFile/Writer/Format/odf_chart_context.cpp
+++ b/OdfFile/Writer/Format/odf_chart_context.cpp
@@ -539,6 +539,20 @@ void odf_chart_context::set_chart_grouping(int type)
 			impl_->current_level_.back().chart_properties->stacked_ = true; break;
 	}
 }
+void odf_chart_context::set_chart_treat_empty_cells(int type)
+{
+	if (!impl_->current_level_.back().chart_properties) return;
+
+	switch(type)
+	{
+		case 0:	//	st_dispblanksasSPAN
+			impl_->current_level_.back().chart_properties->treat_empty_cells_ = L"ignore"; break;
+		case 1:	//	st_dispblanksasGAP
+			impl_->current_level_.back().chart_properties->treat_empty_cells_ = L"leave-gap"; break;
+		case 2:	//	st_dispblanksasZERO
+			impl_->current_level_.back().chart_properties->treat_empty_cells_ = L"use-zero"; break;
+	}
+}
 void odf_chart_context::set_chart_3D(bool val)
 {
 	if (!impl_->current_level_.back().chart_properties) return;
@@ -1103,8 +1117,6 @@ void odf_chart_context::start_plot_area()
 		style_->content_.add_get_style_graphic_properties();
 	}
 	start_element(impl_->plot_area_, style_elm, style_name);
-	
-	impl_->current_level_.back().chart_properties->treat_empty_cells_ = true;
 }
 void odf_chart_context::end_plot_area()
 {
diff --git a/OdfFile/Writer/Format/odf_chart_context.h b/OdfFile/Writer/Format/odf_chart_context.h
index 258a397574..47ef5fef57 100644
--- a/OdfFile/Writer/Format/odf_chart_context.h
+++ b/OdfFile/Writer/Format/odf_chart_context.h
@@ -60,6 +60,7 @@ public:
 		void set_chart_size			(_CP_OPT(double) width_pt, _CP_OPT(double) height_pt);		
 		void set_chart_colored		(bool val);
 		void set_chart_grouping		(int type);
+		void set_chart_treat_empty_cells(int type);
 		void set_chart_scatter_type	(int type);
 		void set_chart_bar_grouping	(int type);
 		void set_chart_bar_direction(int type);
diff --git a/OdfFile/Writer/Format/style_chart_properties.h b/OdfFile/Writer/Format/style_chart_properties.h
index 75c8afc1f4..72d3d8f86a 100644
--- a/OdfFile/Writer/Format/style_chart_properties.h
+++ b/OdfFile/Writer/Format/style_chart_properties.h
@@ -77,7 +77,7 @@ public:
 	_CP_OPT(odf_types::Bool) mean_value_;	
 	_CP_OPT(odf_types::Bool) error_upper_indicator_;	
 	_CP_OPT(odf_types::Bool) error_lower_indicator_;
-	_CP_OPT(odf_types::Bool) treat_empty_cells_;
+	_CP_OPT(std::wstring) treat_empty_cells_;
 	_CP_OPT(odf_types::Bool) japanese_candle_stick_;
 	
 	_CP_OPT(odf_types::chart_symbol_type) symbol_type_;
