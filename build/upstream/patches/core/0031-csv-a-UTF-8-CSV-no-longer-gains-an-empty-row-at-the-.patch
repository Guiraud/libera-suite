From d0486c90f26d417d3b773778aa743ba0121d8649 Mon Sep 17 00:00:00 2001
From: Stefane Fermigier <sfermigier@gmail.com>
Date: Mon, 5 Oct 2026 22:04:25 +0200
Subject: [PATCH 31/31] csv: a UTF-8 CSV no longer gains an empty row at the
 end

utf8_2_unicode sized its string for one unit per byte, zero-filled it,
and never shrank it to what the conversion wrote. Every multibyte
character left a NUL at the end, the parser read the NULs as another
row, and every save of a UTF-8 CSV added an empty one.
---
 OOXML/Binary/Sheets/Reader/CSVReader.cpp | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/OOXML/Binary/Sheets/Reader/CSVReader.cpp b/OOXML/Binary/Sheets/Reader/CSVReader.cpp
index cb22b71e44..462a0349c0 100644
--- a/OOXML/Binary/Sheets/Reader/CSVReader.cpp
+++ b/OOXML/Binary/Sheets/Reader/CSVReader.cpp
@@ -83,6 +83,11 @@ private:
 			eUnicodeConversionResult = ConvertUTF8toUTF16 (&pStrUtf8_Conv,	 &pStrUtf8[nLength]
 					, &pStrUtf16_Conv, &((UTF16 *)wStr.data())[nLength]
 					, strictConversion);
+			// What was converted and nothing after it. The string was sized for
+			// one unit per byte and zero-filled, so a multibyte character left a
+			// NUL at the end for each byte it saved, and the parser read the NULs
+			// as one more row: every save of a UTF-8 CSV added an empty row.
+			wStr.resize(pStrUtf16_Conv - (UTF16 *)wStr.data());
 		}
 		else //utf8 -> utf32
 		{
@@ -98,6 +103,7 @@ private:
 			eUnicodeConversionResult = ConvertUTF8toUTF32 (&pStrUtf8_Conv, &pStrUtf8[nLength]
 					, &pStrUtf32_Conv, &((UTF32 *)wStr.data())[nLength]
 					, strictConversion);
+			wStr.resize(pStrUtf32_Conv - (UTF32 *)wStr.data());
 		}
 		if (conversionOK != eUnicodeConversionResult)
 		{
