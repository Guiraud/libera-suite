 			break;
 		case office_value_type::Boolean:
-			cell->attlist_.common_value_and_type_attlist_->office_boolean_value_ = value;
+			// XLSX writes a boolean cell as 0 or 1; ODF wants false or true.
+			cell->attlist_.common_value_and_type_attlist_->office_boolean_value_ =
+				value == L"1" ? L"true" : value == L"0" ? L"false" : value;
 			break;
 		case office_value_type::Date:
 		case office_value_type::Time:
