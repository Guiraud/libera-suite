diff --git a/OdfFile/Writer/Format/table.h b/OdfFile/Writer/Format/table.h
index 615834444d..4bae4a302d 100644
--- a/OdfFile/Writer/Format/table.h
+++ b/OdfFile/Writer/Format/table.h
@@ -372,6 +372,12 @@ public:
     table_table_column_group_attlist	table_table_column_group_attlist_;
     table_columns_and_groups			table_columns_and_groups_;
 
+	// XLSX says an outline group is collapsed only by hiding its members; ODF says it
+	// on the group. Counted as the members are added and hidden, read at serialisation.
+	int members_ = 0;
+	int hidden_members_ = 0;
+	bool collapsed() const { return members_ > 0 && hidden_members_ == members_; }
+
 };
 
 CP_REGISTER_OFFICE_ELEMENT2(table_table_column_group);
@@ -585,6 +591,12 @@ public:
     table_table_row_group_attlist table_table_row_group_attlist_;
     table_rows_and_groups table_rows_and_groups_;
 
+	// XLSX says an outline group is collapsed only by hiding its members; ODF says it
+	// on the group. Counted as the members are added and hidden, read at serialisation.
+	int members_ = 0;
+	int hidden_members_ = 0;
+	bool collapsed() const { return members_ > 0 && hidden_members_ == members_; }
+
 };
 
 CP_REGISTER_OFFICE_ELEMENT2(table_table_row_group);
