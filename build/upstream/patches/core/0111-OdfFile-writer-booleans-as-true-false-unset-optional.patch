@@ -490,6 +495,8 @@ void ods_table_state::add_row(office_element_ptr & elm, _UINT32 repeated, office
 		}
 	}
 	current_level_.back()->add_child_element(elm);
+	if (table_table_row_group* group = dynamic_cast<table_table_row_group*>(current_level_.back().get()))
+		group->members_++;
 
 	std::wstring style_name;
 
@@ -533,6 +540,10 @@ void ods_table_state::set_row_hidden(bool Val)
 	table_table_row* row = dynamic_cast<table_table_row*>(rows_.back().elm.get());
 	if (row == NULL)return;
 
+	// Hidden and collapsed both land here for one row; count it once.
+	if (!row->attlist_.table_visibility_)
+		if (table_table_row_group* group = dynamic_cast<table_table_row_group*>(current_level_.back().get()))
+			group->hidden_members_++;
 	row->attlist_.table_visibility_ = table_visibility(table_visibility::Collapse);
 }
