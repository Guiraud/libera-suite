From cfd4136c391a8e107d168805a259feee790283f9 Mon Sep 17 00:00:00 2001
From: Stefane Fermigier <sf@abilian.com>
Date: Fri, 25 Sep 2026 08:54:40 +0200
Subject: [PATCH 50/82] OdfFile writer: each piece of a tracked change is a
 region with its own id

A DOCX change split into pieces, one w:ins or w:del per run or
paragraph, repeats its w:id, and the writer named each piece's
text:changed-region "ct" + w:id. So a document had several regions with
the same xml:id: 28 of LibreOffice's ODF test documents after the sixth
batch. Each piece is a region of its own, holding its own deleted text,
so each now gets its own name, ct2, ct2_2, ...; the end of an insertion
or format change refers to the name its start was given.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 OdfFile/Writer/Format/odt_conversion_context.cpp | 10 ++++++++++
 OdfFile/Writer/Format/odt_conversion_context.h   |  4 ++++
 2 files changed, 14 insertions(+)

diff --git a/OdfFile/Writer/Format/odt_conversion_context.cpp b/OdfFile/Writer/Format/odt_conversion_context.cpp
index 56732da7b1..aae8141510 100644
--- a/OdfFile/Writer/Format/odt_conversion_context.cpp
+++ b/OdfFile/Writer/Format/odt_conversion_context.cpp
@@ -1554,6 +1554,10 @@ bool odt_conversion_context::start_change (int id, int type, std::wstring &autho
 	text_changes_state_.current_types.push_back(type);
 
 	std::wstring strId = L"ct" + boost::lexical_cast<std::wstring>(id);
+	for (int n = 2; text_changes_state_.used_ids.count(strId); n++)
+		strId = L"ct" + boost::lexical_cast<std::wstring>(id) + L"_" + std::to_wstring(n);
+	text_changes_state_.used_ids.insert(strId);
+	text_changes_state_.open_ids[id].push_back(strId);
 //---------------------------------------------------------------------------------
 	office_element_ptr start_elm;
 
@@ -1632,6 +1636,12 @@ void odt_conversion_context::end_change (int id, int type)
 	//if (!text_changes_state_.main_text_context) return;
 	
 	std::wstring strId = L"ct" + boost::lexical_cast<std::wstring>(id);
+	std::vector<std::wstring> & open = text_changes_state_.open_ids[id];
+	if (false == open.empty())
+	{
+		strId = open.back();
+		open.pop_back();
+	}
 
 	if (type == 2)//delete
 	{
diff --git a/OdfFile/Writer/Format/odt_conversion_context.h b/OdfFile/Writer/Format/odt_conversion_context.h
index 4604b47ab6..8523a5d672 100644
--- a/OdfFile/Writer/Format/odt_conversion_context.h
+++ b/OdfFile/Writer/Format/odt_conversion_context.h
@@ -263,6 +263,10 @@ private:
 	{
 		odf_text_context	*main_text_context;
 		std::vector<int>	current_types;
+		// A DOCX change split into pieces, one per run or paragraph, repeats its w:id; each
+		// piece is a region of its own, so each gets a name of its own, and its end the same
+		std::map<int, std::vector<std::wstring>>	open_ids;
+		std::set<std::wstring>						used_ids;
 	}text_changes_state_;
 
 	bool table_row_header_state_ = false;
