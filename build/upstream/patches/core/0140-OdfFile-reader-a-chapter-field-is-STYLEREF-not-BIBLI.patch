From 11a6bb24e82b9c43099b3e37a4b78cbd467d3968 Mon Sep 17 00:00:00 2001
From: Stefane Fermigier <sf@abilian.com>
Date: Fri, 25 Sep 2026 08:58:12 +0200
Subject: [PATCH 140/142] OdfFile reader: a chapter field is STYLEREF, not
 BIBLIOGRAPHY

chapter::docx_convert wrote every text:chapter as a BIBLIOGRAPHY field.
Word showed its result text, but the writer turned each one into a
text:bibliography index on the way back, without a source and nested in
the previous one: 10 of LibreOffice's ODF test documents after the sixth
batch. A chapter field is now STYLEREF on the heading style of its
outline level, with \n where it shows the number, which Word evaluates
as ODF means it.

OdfFile writer: STYLEREF is not a bookmark reference

The writer took any field instruction containing REF for a REF field,
STYLEREF included, and wrote it as a text:bookmark-ref without a target,
whose text-only content could not hold the spaces of a heading's text:
tdf137855.odt and tdf137855_2.odt, once the reader wrote chapter fields
as STYLEREF. A STYLEREF field now keeps its result as text.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 OdfFile/Reader/Format/paragraph_elements.cpp     | 10 +++++++++-
 OdfFile/Reader/Format/paragraph_elements.h       |  2 ++
 OdfFile/Writer/Format/odt_conversion_context.cpp |  3 ++-
 3 files changed, 13 insertions(+), 2 deletions(-)

diff --git a/OdfFile/Reader/Format/paragraph_elements.cpp b/OdfFile/Reader/Format/paragraph_elements.cpp
index 7ce81f4642..adeea8a995 100644
--- a/OdfFile/Reader/Format/paragraph_elements.cpp
+++ b/OdfFile/Reader/Format/paragraph_elements.cpp
@@ -1161,6 +1161,8 @@ std::wostream & chapter::text_to_stream(std::wostream & _Wostream, bool bXmlEnco
 void chapter::add_attributes( const xml::attributes_wc_ptr & Attributes )
 {
     CP_APPLY_ATTR(L"text:fixed", text_fixed_);
+    CP_APPLY_ATTR(L"text:display", text_display_);
+    CP_APPLY_ATTR(L"text:outline-level", text_outline_level_);
 }
 void chapter::add_text(const std::wstring & Text)
 {
@@ -1168,7 +1170,13 @@ void chapter::add_text(const std::wstring & Text)
 }
 void chapter::docx_convert(oox::docx_conversion_context & Context)
 {
- 	docx_serialize_field(L"BIBLIOGRAPHY", text_, Context);
+	// Word's chapter field is STYLEREF on the heading of that level, \n for its number. It was
+	// written as BIBLIOGRAPHY, which became a bibliography index on the way back
+	std::wstring instr = L" STYLEREF \"Heading " + std::to_wstring(text_outline_level_.get_value_or(1)) + L"\"";
+	const std::wstring display = text_display_.get_value_or(L"number-and-name");
+	if (display == L"number" || display == L"plain-number")
+		instr += L" \\n";
+ 	docx_serialize_field(instr + L" ", text_, Context);
 }
 
 void chapter::xlsx_convert(oox::xlsx_conversion_context & Context)
diff --git a/OdfFile/Reader/Format/paragraph_elements.h b/OdfFile/Reader/Format/paragraph_elements.h
index 742f51cc5a..7b45779de3 100644
--- a/OdfFile/Reader/Format/paragraph_elements.h
+++ b/OdfFile/Reader/Format/paragraph_elements.h
@@ -645,6 +645,8 @@ public:
     virtual void pptx_convert(oox::pptx_conversion_context & Context) ;
 
 	_CP_OPT(odf_types::Bool)	text_fixed_;
+	_CP_OPT(std::wstring)		text_display_;
+	_CP_OPT(int)				text_outline_level_;
 	office_element_ptr			text_;    
 private:
     virtual void add_attributes( const xml::attributes_wc_ptr & Attributes );
diff --git a/OdfFile/Writer/Format/odt_conversion_context.cpp b/OdfFile/Writer/Format/odt_conversion_context.cpp
index aae8141510..baceb2dc5e 100644
--- a/OdfFile/Writer/Format/odt_conversion_context.cpp
+++ b/OdfFile/Writer/Format/odt_conversion_context.cpp
@@ -811,7 +811,8 @@ void odt_conversion_context::set_field_instr()
 			current_fields.back().value = instr.substr(9, instr.length() - 5);
 	}
 	res1 = instr.find(L"REF");
-	if (std::wstring::npos != res1 && current_fields.back().type == 0)
+	// Not STYLEREF, a heading's text or number: it has no bookmark, and its result is kept as text
+	if (std::wstring::npos != res1 && std::wstring::npos == instr.find(L"STYLEREF") && current_fields.back().type == 0)
 	{
 		current_fields.back().type = fieldRef;
 
